# MySQL Database Connection URL
# Hướng dẫn:
# - Nếu dùng XAMPP mặc định (user: root, không có password): mysql://root:@localhost:3306/vlu_barcode_lab
# - Nếu có password (ví dụ '123456'): mysql://root:123456@localhost:3306/vlu_barcode_lab
DATABASE_URL="mysql://root:@localhost:3306/vlu_barcode_lab"

# Khóa bí mật ký HMAC chống giả mạo Thẻ QR Cá Nhân (đổi sang chuỗi bí mật riêng trên production)
QR_JWT_SECRET="vlu-lab-qr-secret-2026-vanlang"

# Cấu hình Gửi Email Thẻ QR Cá Nhân (Chọn 1 trong 3 kênh bên dưới)
# KÊNH 1 (Khuyên dùng cho FITLAB Cloud vì đi qua cổng HTTPS 443, không bị chặn SMTP):
# EMAIL_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec"

# KÊNH 2 (Resend API qua HTTPS 443):
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# RESEND_FROM="VLU Lab <onboarding@resend.dev>"

# KÊNH 3 (SMTP truyền thống trên máy Local / XAMPP):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"



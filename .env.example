# Cấu hình biến môi trường dành riêng cho FITLAB Cloud
DATABASE_URL="file:./dev.db"
BASE_PATH="/absproxy/3000"
JWT_SECRET="vlu-lab-barcode-secret-key-2026-super-secure"
NODE_ENV="development"

# Khóa bí mật ký HMAC chống giả mạo Thẻ QR Cá Nhân (đổi sang chuỗi bí mật riêng trên production)
QR_JWT_SECRET="vlu-lab-qr-secret-2026-vanlang"

# Cấu hình Gửi Email Thẻ QR Cá Nhân qua Brevo API (Free 300 mail/ngày, chạy ổn định trên FITLAB qua HTTPS 443)
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="your-verified-gmail@gmail.com"

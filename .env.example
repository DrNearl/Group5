# Cấu hình biến môi trường dành riêng cho FITLAB Cloud
DATABASE_URL="file:./dev.db"
BASE_PATH="/absproxy/3000"
JWT_SECRET="vlu-lab-barcode-secret-key-2026-super-secure"
NODE_ENV="development"

# Khóa bí mật ký HMAC chống giả mạo Thẻ QR Cá Nhân (đổi sang chuỗi bí mật riêng trên production)
QR_JWT_SECRET="vlu-lab-qr-secret-2026-vanlang"

# Cấu hình Gửi Email Thẻ QR Cá Nhân (Chọn 1 trong 3 kênh bên dưới)
# KÊNH 1 (Free ~100 mail/ngày, không cần domain riêng, chạy qua HTTPS 443 trên FITLAB):
# EMAIL_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_DEPLOY_ID/exec"

# KÊNH 2 (Brevo API - Free 300 mail/ngày, không cần domain riêng, chạy qua HTTPS 443 trên FITLAB):
# BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxx"
# BREVO_SENDER_EMAIL="your-verified-gmail@gmail.com"

# KÊNH 3 (Resend API qua HTTPS 443 - yêu cầu domain riêng khi gửi cho sinh viên):
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# RESEND_FROM="VLU Lab <onboarding@resend.dev>"

# KÊNH 3 (SMTP truyền thống - chỉ chạy trên máy Local/XAMPP nếu FITLAB chặn cổng 465/587):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-char-app-password"

// Prisma Schema for VLU Lab Duty & Barcode Attendance System
// Trường Đại học Văn Lang - Khoa Công nghệ Thông tin
// Hệ quản trị cơ sở dữ liệu: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------- ENUMS ----------------------
enum Role {
  ADMIN       // Quản trị viên hệ thống / Trưởng bộ môn
  LECTURER    // Giảng viên phụ trách phòng Lab
}

enum LabStatus {
  ACTIVE
  MAINTENANCE
}

enum ScheduleStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  ABSENT
}

enum ScanMethod {
  USB_SCANNER
  WEBCAM
  DYNAMIC_QR
}

enum AttendanceStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
  MISSING_CHECKOUT
}

enum EquipmentCategory {
  PC
  MONITOR
  PROJECTOR
  AIR_CONDITIONER
  NETWORK
  PERIPHERAL
}

enum EquipmentStatus {
  GOOD
  BROKEN
  REPAIRING
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ---------------------- MODELS ----------------------

// 1. User: Tài khoản Đăng nhập Quản lý (Chỉ dành cho Giảng viên & Quản trị viên)
model User {
  id           String   @id @default(uuid())
  username     String   @unique // Mã GV hoặc tên tài khoản quản trị (vd: "GV001", "admin")
  fullName     String   // Họ tên Giảng viên / Quản trị viên
  email        String   @unique // Email liên hệ VLU (chau.lth@vlu.edu.vn)
  passwordHash String
  phone        String?
  role         Role     @default(LECTURER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Student: Danh mục Sinh viên trực Lab (Dùng mã Barcode trên thẻ SV để quẹt, KHÔNG cần tài khoản đăng nhập)
model Student {
  id          String   @id @default(uuid())
  studentCode String   @unique // MSSV - Mã vạch Code 128 trên thẻ sinh viên (vd: "2373401010100")
  fullName    String
  email       String?  // Email sinh viên Văn Lang (để gửi thông báo ca trực)
  phone       String?
  className   String?  // Lớp chuyên ngành (vd: "23DTH01", "21CNTT02")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dutySchedules     DutySchedule[]
  reportedIncidents EquipmentIncident[]

  @@index([studentCode])
}

// 3. LabRoom: Phòng máy thực hành thực tế tại VLU
model LabRoom {
  id        String    @id @default(uuid())
  labCode   String    @unique // VD: "LAB-CS3-G801"
  labName   String    // VD: "Phòng Lab Mạng máy tính & An ninh mạng 8.01"
  building  String    // VD: "Cơ sở 3 - Tòa nhà G, Tầng 8"
  capacity  Int       @default(45) // Số lượng máy tính trạm thực tế
  allowedIp String?   // Dải IP tĩnh của phòng Lab
  status    LabStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dutySchedules DutySchedule[]
  equipments    LabEquipment[]
}

// 4. Shift: Khung ca trực chính thức theo quy định VLU
model Shift {
  id                 String   @id @default(uuid())
  shiftName          String   // "Ca 1 (Sáng: Tiết 1 - 6)", "Ca 2 (Chiều: Tiết 7 - 12)", "Ca 3 (Tối: Tiết 13 - 16)"
  startTime          String   // "07:00"
  endTime            String   // "11:30"
  gracePeriodMinutes Int      @default(15) // Cho phép trễ tối đa 15 phút
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dutySchedules DutySchedule[]
}

// 5. DutySchedule: Lịch phân công ca trực của sinh viên
model DutySchedule {
  id             String         @id @default(uuid())
  studentId      String
  labId          String
  shiftId        String
  dutyDate       DateTime       @db.Date // Ngày trực
  scheduleStatus ScheduleStatus @default(PENDING)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  student       Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  labRoom       LabRoom             @relation(fields: [labId], references: [id], onDelete: Cascade)
  shift         Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  attendanceLog AttendanceLog?
  incidents     EquipmentIncident[]

  @@index([studentId])
  @@index([dutyDate])
}

// 6. AttendanceLog: Nhật ký quét Barcode Điểm danh Check-in / Check-out
model AttendanceLog {
  id               String           @id @default(uuid())
  scheduleId       String           @unique
  scannedBarcode   String           // Chuỗi mã vạch quét được từ thẻ SV
  checkInTime      DateTime?
  checkOutTime     DateTime?
  scanMethod       ScanMethod       @default(USB_SCANNER)
  checkInSnapshot  String?          @db.LongText // LongText chứa ảnh Base64 JPEG không bị giới hạn dung lượng trong MySQL
  checkOutSnapshot String?          @db.LongText // LongText chứa ảnh Base64 JPEG lúc check-out
  clientIp         String?          // IP máy trạm thực hiện quét
  attendanceStatus AttendanceStatus @default(ON_TIME)
  totalHours       Float            @default(0) // Số giờ trực thực tế: (checkOut - checkIn) / 3600
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  dutySchedule DutySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

// 7. LabEquipment & EquipmentIncident: Quản lý thiết bị máy trạm & Báo hỏng Barcode
model LabEquipment {
  id               String            @id @default(uuid())
  equipmentBarcode String            @unique // Mã Barcode in trên tem máy: "EQ-LAB801-PC01"
  equipmentName    String            // Tên máy: "Máy trạm PC 01 - Phòng Lab 8.01"
  category         EquipmentCategory @default(PC)
  labId            String
  status           EquipmentStatus   @default(GOOD)
  specifications   String?           @db.Text // Cấu hình chi tiết máy trạm thật VLU
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  labRoom   LabRoom             @relation(fields: [labId], references: [id], onDelete: Cascade)
  incidents EquipmentIncident[]

  @@index([equipmentBarcode])
}

model EquipmentIncident {
  id                  String           @id @default(uuid())
  equipmentId         String
  reportedByStudentId String?
  scheduleId          String?
  title               String
  description         String           @db.Text
  severity            IncidentSeverity @default(MEDIUM)
  incidentStatus      IncidentStatus   @default(OPEN)
  createdAt           DateTime         @default(now())
  resolvedAt          DateTime?

  equipment  LabEquipment  @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reportedBy Student?      @relation(fields: [reportedByStudentId], references: [id], onDelete: SetNull)
  schedule   DutySchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
}

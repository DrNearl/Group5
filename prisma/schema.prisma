// Prisma Schema for VLU Lab Duty & Barcode Attendance System
// Trường Đại học Văn Lang - Khoa Công nghệ Thông tin
// Hệ quản trị cơ sở dữ liệu: Microsoft SQL Server (MSSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------- MODELS ----------------------

// 1. User: Tài khoản Đăng nhập Quản lý (Chỉ dành cho Giảng viên & Quản trị viên)
model User {
  id           String   @id @default(uuid())
  username     String   @unique // Mã GV hoặc tên tài khoản quản trị (vd: "GV001", "admin")
  fullName     String   // Họ tên Giảng viên / Quản trị viên
  email        String   @unique // Email liên hệ VLU (chau.lth@vlu.edu.vn)
  passwordHash String
  phone        String?
  role         String   @default("LECTURER") // ADMIN, LECTURER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Student: Danh mục Sinh viên trực Lab (Dùng mã Barcode trên thẻ SV để quẹt, KHÔNG cần tài khoản đăng nhập)
model Student {
  id            String    @id @default(uuid())
  studentCode   String    @unique // MSSV - Mã vạch Code 128 trên thẻ sinh viên (vd: "2373401010100")
  fullName      String?
  email         String? // Email sinh viên Văn Lang (để gửi thông báo ca trực)
  phone         String?
  className     String? // Lớp chuyên ngành (vd: "23DTH01", "21CNTT02")
  profileStatus String    @default("VERIFIED") // PENDING, VERIFIED
  source        String    @default("MANUAL") // MANUAL, SCAN_AUTO, IMPORT
  firstSeenAt   DateTime?
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  deactivatedBy String?
  reactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dutySchedules     DutySchedule[]
  reportedIncidents EquipmentIncident[]
  rejectedScans     RejectedScan[]

  @@index([studentCode])
}

model RejectedScan {
  id        String   @id @default(uuid())
  rawCode   String
  studentId String?
  reason    String // INVALID_FORMAT, INACTIVE_STUDENT
  scannedAt DateTime @default(now())
  source    String?
  device    String?
  clientIp  String?

  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([studentId, reason, scannedAt])
}

// 3. LabRoom: Phòng máy thực hành thực tế tại VLU
model LabRoom {
  id        String   @id @default(uuid())
  labCode   String   @unique // VD: "LAB-CS3-G801"
  labName   String   // VD: "Phòng Lab Mạng máy tính & An ninh mạng 8.01"
  building  String   // VD: "Cơ sở 3 - Tòa nhà G, Tầng 8"
  capacity  Int      @default(45) // Số lượng máy tính trạm thực tế
  allowedIp String?  // Dải IP tĩnh của phòng Lab
  status    String   @default("ACTIVE") // ACTIVE, MAINTENANCE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dutySchedules DutySchedule[]
  equipments    LabEquipment[]
}

// 4. Shift: Khung ca trực chính thức theo quy định VLU
model Shift {
  id                 String   @id @default(uuid())
  shiftName          String   // "Ca Sáng (08:00 - 11:30)", "Ca Chiều (13:00 - 17:00)"
  startTime          String   // "08:00"
  endTime            String   // "11:30"
  gracePeriodMinutes Int      @default(15) // Cho phép trễ tối đa 15 phút
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dutySchedules DutySchedule[]
}

// 5. DutySchedule: Lịch phân công ca trực của sinh viên
model DutySchedule {
  id             String   @id @default(uuid())
  studentId      String
  labId          String
  shiftId        String
  dutyDate       DateTime @db.Date // Ngày trực
  scheduleStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED, ABSENT
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student       Student             @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labRoom       LabRoom             @relation(fields: [labId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shift         Shift               @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendanceLog AttendanceLog?
  incidents     EquipmentIncident[]

  @@index([studentId])
  @@index([dutyDate])
}

// 6. AttendanceLog: Nhật ký quét Barcode Điểm danh Check-in / Check-out
model AttendanceLog {
  id               String    @id @default(uuid())
  scheduleId       String    @unique
  scannedBarcode   String    // Chuỗi mã vạch quét được từ thẻ SV
  checkInTime      DateTime?
  checkOutTime     DateTime?
  scanMethod       String    @default("USB_SCANNER") // USB_SCANNER, WEBCAM, DYNAMIC_QR
  checkInSnapshot  String?   @db.LongText // Ảnh Base64 JPEG lúc check-in
  checkOutSnapshot String?   @db.LongText // Ảnh Base64 JPEG lúc check-out
  clientIp         String?   // IP máy trạm thực hiện quét
  attendanceStatus String    @default("ON_TIME") // ON_TIME, LATE, EARLY_LEAVE, MISSING_CHECKOUT
  totalHours       Float     @default(0) // Số giờ trực thực tế: (checkOut - checkIn) / 3600
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dutySchedule DutySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

// 7. LabEquipment & EquipmentIncident: Quản lý thiết bị máy trạm & Báo hỏng Barcode
model LabEquipment {
  id               String   @id @default(uuid())
  equipmentBarcode String   @unique // Mã Barcode in trên tem máy: "EQ-LAB801-PC01"
  equipmentName    String   // Tên máy: "Máy trạm PC 01 - Phòng Lab 8.01"
  category         String   @default("PC") // PC, MONITOR, PROJECTOR, AIR_CONDITIONER, NETWORK, PERIPHERAL
  labId            String
  status           String   @default("GOOD") // GOOD, BROKEN, REPAIRING
  specifications   String?  @db.Text // Cấu hình chi tiết máy trạm thật VLU
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  labRoom   LabRoom             @relation(fields: [labId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  incidents EquipmentIncident[]

  @@index([equipmentBarcode])
}

model EquipmentIncident {
  id                  String    @id @default(uuid())
  equipmentId         String
  reportedByStudentId String?
  scheduleId          String?
  title               String
  description         String    @db.Text
  severity            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  incidentStatus      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime?

  equipment  LabEquipment  @relation(fields: [equipmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedBy Student?      @relation(fields: [reportedByStudentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule   DutySchedule? @relation(fields: [scheduleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
